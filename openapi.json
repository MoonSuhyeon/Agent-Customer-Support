{
  "components": {
    "schemas": {
      "AgentOut": {
        "properties": {
          "awaiting_confirmation": {
            "title": "Awaiting Confirmation",
            "type": "boolean"
          },
          "decision": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DecisionOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "escalated": {
            "title": "Escalated",
            "type": "boolean"
          },
          "response": {
            "title": "Response",
            "type": "string"
          },
          "session_id": {
            "title": "Session Id",
            "type": "string"
          },
          "verified": {
            "default": false,
            "title": "Verified",
            "type": "boolean"
          }
        },
        "required": [
          "session_id",
          "response",
          "awaiting_confirmation",
          "escalated"
        ],
        "title": "AgentOut",
        "type": "object"
      },
      "ConfirmIn": {
        "properties": {
          "approved": {
            "default": true,
            "title": "Approved",
            "type": "boolean"
          },
          "session_id": {
            "title": "Session Id",
            "type": "string"
          }
        },
        "required": [
          "session_id"
        ],
        "title": "ConfirmIn",
        "type": "object"
      },
      "DecisionOut": {
        "description": "판단 결과. **`proceed` 에 따라 나머지 필드가 갈린다.**\n\n거절이면 `reason` 만, 진행이면 환불 정보가 실린다. 한 모델로 두되 서로\n배타적인 필드를 선택으로 남긴다 — 소비자가 `proceed` 를 보고 갈라야 한다는\n사실이 스키마에 드러나야 하기 때문이다. `dict` 로 두면 그 사실이 사라지고,\n화면은 환불 금액이 항상 있다고 가정하게 된다.",
        "properties": {
          "policy": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Policy"
          },
          "proceed": {
            "title": "Proceed",
            "type": "boolean"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "refund_amount": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Refund Amount"
          },
          "refund_ratio": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Refund Ratio"
          }
        },
        "required": [
          "proceed"
        ],
        "title": "DecisionOut",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "MessageIn": {
        "properties": {
          "message": {
            "minLength": 1,
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "minLength": 1,
            "title": "Request Id",
            "type": "string"
          },
          "session_id": {
            "minLength": 1,
            "title": "Session Id",
            "type": "string"
          }
        },
        "required": [
          "session_id",
          "message",
          "request_id"
        ],
        "title": "MessageIn",
        "type": "object"
      },
      "SessionOut": {
        "description": "세션 현재 상태.\n\n예전에는 `dict` 를 그대로 돌려줬다. 그러면 OpenAPI 에 모양이 안 실리고,\n소비자는 응답 모양을 손으로 적을 수밖에 없다 — 그렇게 적힌 것은 서비스가\n바뀌어도 아무 데서도 안 걸린다.",
        "properties": {
          "awaiting_confirmation": {
            "title": "Awaiting Confirmation",
            "type": "boolean"
          },
          "decision": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DecisionOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "escalated": {
            "title": "Escalated",
            "type": "boolean"
          },
          "next_nodes": {
            "items": {
              "type": "string"
            },
            "title": "Next Nodes",
            "type": "array"
          },
          "response": {
            "title": "Response",
            "type": "string"
          },
          "session_id": {
            "title": "Session Id",
            "type": "string"
          },
          "trace": {
            "items": {
              "$ref": "#/components/schemas/TraceEntry"
            },
            "title": "Trace",
            "type": "array"
          }
        },
        "required": [
          "session_id",
          "awaiting_confirmation",
          "next_nodes",
          "response",
          "escalated",
          "trace"
        ],
        "title": "SessionOut",
        "type": "object"
      },
      "TraceEntry": {
        "additionalProperties": true,
        "description": "트레이스 한 줄.\n\n**`node` 만 보장한다.** 나머지 키는 노드마다 다르고, 노드가 늘면 또 달라진다.\n전부 열거하면 노드를 하나 추가할 때마다 스키마가 따라 움직여야 하고, 그렇다고\n통째로 `dict` 로 두면 소비자가 `node` 조차 믿을 수 없다. 보장되는 것만\n보장하고 나머지는 열어 둔다.",
        "properties": {
          "node": {
            "title": "Node",
            "type": "string"
          }
        },
        "required": [
          "node"
        ],
        "title": "TraceEntry",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Agent Customer Support",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/support/confirm": {
      "post": {
        "description": "고객 승인. **이 호출 없이는 상태 변경이 일어나지 않는다.**",
        "operationId": "confirm_support_confirm_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Confirm"
      }
    },
    "/support/messages": {
      "post": {
        "operationId": "send_message_support_messages_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MessageIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Send Message"
      }
    },
    "/support/sessions/{session_id}": {
      "get": {
        "operationId": "get_session_support_sessions__session_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "title": "Session Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Session"
      }
    }
  }
}
